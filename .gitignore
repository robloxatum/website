# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

!.env.example

# Original logo files (sources for scripts/make-brand-assets.py); not deployed
/public/brand/

# Mockups are large reference images; kept locally only
design/mockups/

# Printed flyer files (kept locally and in the club Drive)
design/flyers/

# Exports and spreadsheets (may contain member data)
*.csv
*.xlsx
# ...but not route folders named like files (e.g. src/app/.../members.csv/route.ts)
!src/**/*.csv/
design/exports/

# Local-only analytics demo numbers (npm run analytics:demo)
.analytics-demo.json

# Backups and other zips: never commit (they contain members' data).
*.zip
# ...except the backup download route, a folder named like a file.
!/src/app/(officer)/officer/backup.zip/
