# Copy to .env.local and fill in. The Supabase secret key is only needed for
# push notifications (leave the push lines empty to keep them off locally).
NEXT_PUBLIC_SUPABASE_URL=https://swegqrnmbqflzhczbhou.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# Used in QR codes. http://localhost:3000 locally, https://robloxatum.vercel.app in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Daily keep-alive cron (/api/keep-alive, see vercel.json). Any long random
# string; set the same value in Vercel → Settings → Environment Variables.
CRON_SECRET=
# Push notifications (optional; see README). npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Supabase secret key: server only, push notifications only.
SUPABASE_SECRET_KEY=
